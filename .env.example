# Copy to .env.local and fill in. .env.local is gitignored; this file is committed,
# so it must never contain a real secret.
#
# QUOTE ANY VALUE CONTAINING A # CHARACTER. Node's --env-file parser treats an
# unquoted # as the start of a comment and silently truncates the value at it.
# A password of Abc123#xy read back as Abc123, and the only symptom was an
# authentication failure that blamed the credential.
#   wrong:  GRAPH_CLIENT_SECRET=Abc123#xy
#   right:  GRAPH_CLIENT_SECRET="Abc123#xy"

NEXT_PUBLIC_SUPABASE_URL=https://nwdzpjzllhhqwawmsxjd.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_Qmq5cJo69-PACiTuKnynug_y4lpTyMR
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Mail goes through the Microsoft Graph API, not SMTP: Microsoft 365 blocks
# SMTP AUTH while security defaults are enabled, and is deprecating SMTP client
# submission regardless. These come from an Entra app registration holding the
# Mail.Send application permission with admin consent granted.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
MAIL_FROM=HIMARK <>

# Set EMAIL_TRANSPORT=log to render mail to the console instead of sending it.
# Requires none of the GRAPH_ values, which is what lets tests and local work
# run without Azure credentials.
